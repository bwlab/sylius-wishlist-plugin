{
    "name": "bwlab/sylius-wishlist-plugin",
    "type": "sylius-plugin",
    "description": "Wishlist plugin for Sylius 2: guest and customer wishlists per channel, availability, merchant data.",
    "keywords": ["sylius", "sylius-plugin", "wishlist"],
    "license": "MIT",
    "authors": [{ "name": "bwlab", "homepage": "https://www.bwlab.it" }],
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Bwlab\\SyliusWishlistPlugin\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Bwlab\\SyliusWishlistPlugin\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "symfony/flex": false, "php-http/discovery": false }
    },
    "extra": {
        "branch-alias": { "dev-develop": "1.0-dev" }
    }
}
