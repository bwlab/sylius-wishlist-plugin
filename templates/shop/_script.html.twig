{# Loaded once on every shop page (hook sylius_shop.base#javascripts). Progressive enhancement: without it, every form posts normally. #}
<script>
(function () {
    if (window.bwlabWishlistReady) { return; }
    window.bwlabWishlistReady = true;

    var spinner = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>';

    function setBusy(button, label) {
        if (button.dataset.bwBusy) { return false; }
        button.dataset.bwBusy = '1';
        button.dataset.bwHtml = button.innerHTML;
        button.disabled = true;
        button.innerHTML = spinner + label;
        return true;
    }

    function setIdle(button) {
        button.disabled = false;
        if (button.dataset.bwHtml) { button.innerHTML = button.dataset.bwHtml; }
        delete button.dataset.bwBusy;
    }

    function toast(type, message) {
        var old = document.querySelector('[data-bwlab-wishlist-toast]');
        if (old) { old.remove(); }
        var box = document.createElement('div');
        box.className = 'alert alert-' + ('info' === type ? 'info' : ('error' === type ? 'danger' : 'success')) + ' shadow position-fixed top-0 end-0 m-3';
        box.style.zIndex = '2000';
        box.setAttribute('role', 'alert');
        box.setAttribute('data-bwlab-wishlist-toast', '');
        box.setAttribute('data-test-sylius-flash-message', '');
        box.textContent = message;
        document.body.appendChild(box);
        setTimeout(function () { box.remove(); }, 4000);
    }

    function updateCounter(count) {
        var link = document.querySelector('[data-test-bwlab-wishlist-link]');
        if (!link) { return; }
        var badge = link.querySelector('[data-test-bwlab-wishlist-count]');
        if (count <= 0) { if (badge) { badge.remove(); } return; }
        if (!badge) {
            badge = document.createElement('span');
            badge.className = 'position-absolute top-0 start-0 badge rounded-pill bg-primary';
            link.appendChild(badge);
        }
        badge.setAttribute('data-test-bwlab-wishlist-count', count);
        badge.textContent = count;
    }

    // Destination menu: the list names on the page, the "new list" name field, and the button state per list.
    function destinationOf(scope) {
        return {
            select: scope.querySelector('[data-bwlab-wishlist-destination]'),
            input: scope.querySelector('[data-bwlab-wishlist-new-name]')
        };
    }

    // A list created from one menu shows up in every menu on the page and is selected in this one.
    function syncDestination(scope, list) {
        var id = String(list.id);
        document.querySelectorAll('[data-bwlab-wishlist-destination]').forEach(function (select) {
            if (!select.querySelector('option[value="' + id + '"]')) {
                var option = document.createElement('option');
                option.value = id;
                option.textContent = list.name;
                select.insertBefore(option, select.querySelector('option[value="new"]'));
            }
        });
        var destination = destinationOf(scope);
        if (destination.select) { destination.select.value = id; }
        if (destination.input) { destination.input.value = ''; destination.input.classList.add('d-none'); }
    }

    // Saved state belongs to one list: another list in the menu brings back "Add to wishlist".
    function resetSaved(button) {
        var label = button.querySelector('[data-bw-label]');
        if (label && button.dataset.addLabel) { label.textContent = button.dataset.addLabel; }
        var icon = button.querySelector('svg');
        if (icon) { icon.style.fill = ''; }
        button.disabled = false;
        delete button.dataset.bwSaved;
        delete button.dataset.bwSavedList;
    }

    // Saves through fetch; a network or server failure falls back to the normal form post (which also shows the flash message).
    // A refusal with a message (for instance a bad list name) is shown here and not retried.
    // One save at a time on the page: two parallel first saves of a guest would create two owners (two cookies).
    var saving = false;

    function save(button, url, data, fallback) {
        if (saving) { toast('info', {{ 'bwlab_wishlist.ui.shop.wait_saving'|trans|json_encode|raw }}); return; }
        if (!setBusy(button, button.dataset.savingLabel || '')) { return; }
        saving = true;
        var scope = button.closest('[data-bwlab-wishlist-box]');
        fetch(url, {
            method: 'POST',
            body: data,
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        }).then(function (response) {
            if (response.ok) { return response.json(); }
            return response.json().then(function (refusal) {
                throw { wishlistRefusal: refusal };
            }, function () {
                throw new Error('wishlist');
            });
        }).then(function (result) {
            updateCounter(result.count);
            toast(result.type, result.message);
            setIdle(button);
            var label = button.querySelector('[data-bw-label]');
            if (label) {
                if (!button.dataset.addLabel) { button.dataset.addLabel = label.textContent; }
                label.textContent = button.dataset.savedLabel;
            }
            var icon = button.querySelector('svg');
            if (icon) { icon.style.fill = 'currentColor'; }
            button.dataset.bwSaved = '1';
            button.disabled = true;
            if (result.list && scope) {
                syncDestination(scope, result.list);
                button.dataset.bwSavedList = String(result.list.id);
            }
        }).finally(function () { saving = false; }).catch(function (error) {
            setIdle(button);
            if (error && error.wishlistRefusal && error.wishlistRefusal.message) {
                toast('error', error.wishlistRefusal.message);
                var input = scope ? destinationOf(scope).input : null;
                if (input && !input.classList.contains('d-none')) { input.focus(); }
                return;
            }
            fallback();
        });
    }

    document.addEventListener('change', function (event) {
        var select = event.target.closest('[data-bwlab-wishlist-destination]');
        if (!select) { return; }
        var scope = select.closest('[data-bwlab-wishlist-box]');
        if (!scope) { return; }
        var input = destinationOf(scope).input;
        if (input) {
            input.classList.toggle('d-none', 'new' !== select.value);
            if ('new' === select.value) { input.focus(); }
        }
        var button = scope.querySelector('[data-test-bwlab-wishlist-add]');
        if (button && button.dataset.bwSaved && button.dataset.bwSavedList !== select.value) { resetSaved(button); }
    });

    document.addEventListener('click', function (event) {
        var button = event.target.closest('[data-bwlab-wishlist-pdp]');
        if (!button || button.disabled) { return; }
        var data = new FormData();
        data.append('_token', button.dataset.token);
        data.append('variant', button.dataset.variant);
        data.append('source', 'pdp');
        data.append('returnTo', button.dataset.return);
        var form = button.closest('form');
        var quantity = form ? form.querySelector('input[name$="[quantity]"]') : null;
        if (quantity && quantity.value) { data.append('quantity', quantity.value); }
        // The menu has no field name here (it sits inside the add-to-cart form): send its value by hand.
        var scope = button.closest('[data-bwlab-wishlist-box]');
        var destination = scope ? destinationOf(scope) : { select: null, input: null };
        if (destination.select) {
            data.append('list', destination.select.value);
            if ('new' === destination.select.value) { data.append('list_name', destination.input ? destination.input.value : ''); }
        }

        save(button, button.dataset.url, data, function () {
            var plain = document.createElement('form');
            plain.method = 'post';
            plain.action = button.dataset.url;
            data.forEach(function (value, name) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                plain.appendChild(input);
            });
            document.body.appendChild(plain);
            plain.submit();
        });
    });

    document.addEventListener('submit', function (event) {
        var form = event.target;
        if (form.matches('[data-bwlab-wishlist-save]')) {
            event.preventDefault();
            var button = form.querySelector('button[type=submit]');
            if (button.dataset.bwSaved) { return; }
            save(button, form.action, new FormData(form), function () { HTMLFormElement.prototype.submit.call(form); });
            return;
        }
        if (form.matches('[data-bwlab-busy]')) {
            if (form.dataset.bwBusy) { event.preventDefault(); return; }
            form.dataset.bwBusy = '1';
            var submitter = event.submitter || form.querySelector('button[type=submit]');
            // Disable after the browser has collected the form data.
            setTimeout(function () { setBusy(submitter, form.dataset.bwlabBusy); }, 0);
        }
    });

    // Back/forward cache: never show a page stuck in the "busy" state.
    window.addEventListener('pageshow', function (event) {
        if (!event.persisted) { return; }
        document.querySelectorAll('[data-bw-busy]').forEach(setIdle);
        document.querySelectorAll('form[data-bw-busy]').forEach(function (form) { delete form.dataset.bwBusy; });
    });
})();
</script>
