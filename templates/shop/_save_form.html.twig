{# Variables: variant, source (pdp|plp), class #}
<form action="{{ path('bwlab_wishlist_shop_add') }}" method="post" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('bwlab_wishlist') }}">
    <input type="hidden" name="variant" value="{{ variant.id }}">
    <input type="hidden" name="source" value="{{ source }}">
    <input type="hidden" name="returnTo" value="{{ app.request.requestUri }}">
    <button type="submit" class="btn {{ class|default('btn-outline-secondary') }}" data-test-bwlab-wishlist-add="{{ source }}">
        {{ ux_icon('tabler:heart', {class: 'icon icon-sm'}) }}
        {{ 'bwlab_wishlist.ui.add_to_wishlist'|trans }}
    </button>
</form>
