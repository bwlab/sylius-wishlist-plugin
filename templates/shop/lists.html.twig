{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'bwlab_wishlist.ui.shop.lists.title'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    {% set token = csrf_token('bwlab_wishlist') %}

    <div class="container mt-5 mb-5" data-test-bwlab-wishlist-lists>
        <h1 class="h2 mb-4">{{ 'bwlab_wishlist.ui.shop.lists.title'|trans }}</h1>

        {% if lists is empty %}
            <div class="alert alert-info" data-test-bwlab-wishlist-empty>{{ 'bwlab_wishlist.ui.empty'|trans }}</div>
        {% else %}
            <ul class="list-group mb-4">
                {% for list in lists %}
                    <li class="list-group-item d-flex flex-wrap align-items-center gap-2" data-test-bwlab-wishlist-list="{{ list.id }}">
                        <a class="fw-bold me-auto" href="{{ path('bwlab_wishlist_shop_list', {id: list.id}) }}" data-test-bwlab-wishlist-list-open>{{ bwlab_wishlist_list_name(list) }}</a>
                        {% if list.default %}<span class="badge bg-secondary">{{ 'bwlab_wishlist.ui.shop.lists.default'|trans }}</span>{% endif %}
                        <span class="text-muted small" data-test-bwlab-wishlist-list-count="{{ list.countItems }}">{{ 'bwlab_wishlist.ui.shop.lists.products'|trans({'%count%': list.countItems}) }}</span>
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('bwlab_wishlist_shop_list_rename', {id: list.id}) }}" data-test-bwlab-wishlist-list-rename>{{ 'bwlab_wishlist.ui.shop.lists.rename'|trans }}</a>
                        {% if not list.default %}
                            <a class="btn btn-sm btn-outline-danger" href="{{ path('bwlab_wishlist_shop_list_delete', {id: list.id}) }}" data-test-bwlab-wishlist-list-delete>{{ 'bwlab_wishlist.ui.shop.lists.delete'|trans }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <form id="bwlab-new-list" action="{{ path('bwlab_wishlist_shop_list_create') }}" method="post" class="card card-body" style="max-width: 32rem;" data-bwlab-busy="{{ 'bwlab_wishlist.ui.shop.saving'|trans }}" data-test-bwlab-wishlist-new-list>
            <h2 class="h5">{{ 'bwlab_wishlist.ui.shop.lists.new_list'|trans }}</h2>
            <input type="hidden" name="_token" value="{{ token }}">
            <label class="form-label" for="bwlab-list-name">{{ 'bwlab_wishlist.ui.shop.lists.name'|trans }}</label>
            <input id="bwlab-list-name" class="form-control{{ error ? ' is-invalid' : '' }}" type="text" name="name" value="{{ name }}" maxlength="{{ name_max_length * 2 }}" autocomplete="off" required>
            {% if error %}<div class="invalid-feedback d-block" data-test-bwlab-wishlist-error>{{ error }}</div>{% endif %}
            <div class="form-text">{{ 'bwlab_wishlist.ui.shop.lists.name_hint'|trans({'%limit%': name_max_length, '%max%': max_lists}) }}</div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">{{ 'bwlab_wishlist.ui.shop.lists.create'|trans }}</button>
            </div>
        </form>

        <p class="mt-4"><a class="btn btn-link px-0" href="{{ path('sylius_shop_homepage') }}">{{ 'bwlab_wishlist.ui.continue_shopping'|trans }}</a></p>
    </div>
{% endblock %}
