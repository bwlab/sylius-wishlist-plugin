{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'bwlab_wishlist.ui.shop.lists.rename_title'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mt-5 mb-5" data-test-bwlab-wishlist-rename>
        <h1 class="h2 mb-4">{{ 'bwlab_wishlist.ui.shop.lists.rename_title'|trans }}</h1>
        <form action="{{ path('bwlab_wishlist_shop_list_rename', {id: list.id}) }}" method="post" class="card card-body" style="max-width: 32rem;" data-bwlab-busy="{{ 'bwlab_wishlist.ui.shop.saving'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('bwlab_wishlist') }}">
            <label class="form-label" for="bwlab-list-name">{{ 'bwlab_wishlist.ui.shop.lists.name'|trans }}</label>
            <input id="bwlab-list-name" class="form-control{{ error ? ' is-invalid' : '' }}" type="text" name="name" value="{{ name }}" maxlength="120" autocomplete="off" required>
            {% if error %}<div class="invalid-feedback d-block" data-test-bwlab-wishlist-error>{{ error }}</div>{% endif %}
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">{{ 'bwlab_wishlist.ui.shop.lists.rename_submit'|trans }}</button>
                <a class="btn btn-link" href="{{ path('bwlab_wishlist_shop_lists') }}">{{ 'bwlab_wishlist.ui.shop.lists.cancel'|trans }}</a>
            </div>
        </form>
    </div>
{% endblock %}
